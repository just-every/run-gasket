    "/asset.create": {
      "post": {
        "summary": "asset.create",
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]+$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application\u002fjson": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              },
              "example": {
                "tag": "00042",
                "name": "Pump",
                "location": "Workshop"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Original action result; Idempotency-Replayed header identifies a retry",
            "content": {
              "application\u002fjson": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
