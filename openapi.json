  "components": {
    "securitySchemes": {
      "memberSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-operator_session",
        "description": "Use the cookie name and value returned by ordinary installation sign-in; the deployed session cookie name may differ."
      },
      "serviceBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Owner-issued explicit scopes and expiry. Never send credentials to another origin."
      }
    },
    "responses": {
      "Error": {
        "description": "Machine-readable business or authorization error; API.md defines status codes and reconciliation of uncertain write claims.",
        "content": {
          "application\u002fjson": {
            "schema": {
              "type": "object",
              "required": [
                "error"
              ],
              "properties": {
                "error": {
                  "type": "string"
                },
                "detail": {}
              },
              "additionalProperties": false
            }
          }
        }
      }
    }
