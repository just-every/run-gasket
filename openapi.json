{
  "openapi": "3.1.0",
  "info": {
    "title": "Gasket version 1 estate and retry API",
    "version": "1.0.0",
    "description": "Native estate subset. API.md documents all existing legacy actions and field semantics. This file does not claim complete target-entity schema coverage. POST requests require the installation Origin header. A scoped bearer credential can use only its explicit scopes and cannot approve or administer the site."
  },
  "servers": [
    {
      "url": "/api/gasket/v1"
    }
  ],
  "security": [
    {
      "memberSession": []
    },
    {
      "serviceBearer": []
    }
  ],
  "paths": {
    "/assets": {
      "get": {
        "summary": "Page assets",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 100
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "site",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Live authorized page; authorized summary rows, total and opaque next cursor",
            "content": {
              "application\u002fjson": {
                "schema": {
                  "type": "object",
                  "required": [
                    "rows",
                    "total",
                    "next"
                  ],
                  "properties": {
                    "rows": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    },
                    "total": {
                      "type": "integer"
                    },
                    "next": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
